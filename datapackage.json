          },
          {
            "id": "annual_volume",
            "name": "Annual volume of transactions",
            "title": "Annual volume of transactions",
            "type": "string"
          },
          {
            "id": "data_handling_rules",
            "name": "Data-handing rules for payment system",
            "title": "Data-handing rules for payment system",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "reporting_forum",
            "name": "Reporting forum",
            "title": "Reporting forum",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "aml_law",
            "name": "AML Law",
            "title": "AML Law",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "transaction_cost",
            "name": "Cost of transactions",
            "title": "Cost of transactions",
            "type": "string"
          },
          {
            "id": "qr_code",
            "name": "QR code based transactions",
            "title": "QR code based transactions",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          }
        ]
      }
    },
