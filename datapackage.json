            "title": "Interoperability policy",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "transaction_types",
            "name": "Types of transactions supported",
            "title": "Types of transactions supported",
            "type": "string",
            "constraints": {
              "pattern": "(P2P|B2B|P2M|B2P|G2P|B2G|Other)(, (P2P|B2B|P2M|B2P|G2P|B2G|Other))*"
            }
          },
          {
            "id": "settlement_type",
            "name": "Type of settlement system",
            "title": "Type of settlement system",
            "type": "string",
            "constraints": {
              "pattern": "(RTGS|DNS|MN|ACH)(, (RTGS|DNS|MN|ACH))*"
            }
          },
          {
            "id": "operator",
            "name": "Operator",
            "title": "Operator",
            "type": "string",
            "constraints": {
              "enum": ["Central bank", "Commercial bank/Private PSP", "Bank association", "Bank association/Central bank", "Other"]
            }
          },
          {
            "id": "bank_participation",
            "name": "Bank participation",
            "title": "Bank participation",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "nonbank_participation",
            "name": "Non-bank participation",
            "title": "Non-bank participation",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "participation_rules",
            "name": "Participation conditions and rules",
            "title": "Participation conditions and rules",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "participants",
            "name": "Number of participants",
            "title": "Number of participants",
            "type": "string"
          },
          {
            "id": "annual_value_usd",
            "name": "Annual value of transactions (USD)",
            "title": "Annual value of transactions (USD)",
