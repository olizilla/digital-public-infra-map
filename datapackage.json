            "title": "Active-real time payment system present",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "system_type",
            "name": "Payment system type",
            "title": "Payment system type",
            "type": "string",
            "constraints": {
              "enum": ["Cross-domain", "Interbank", "Mobile money", "CBDC", "Card Payment"]
            }
          },
          {
            "id": "status",
            "name": "Status of Implementation",
            "title": "Status of payment system implementation",
            "type": "string",
            "constraints": {
              "enum": ["Planned/Piloted", "Implemented"]
            }
          },
          {
            "id": "national_regional",
            "name": "National / Regional",
            "title": "National / Regional",
            "type": "string",
            "constraints": {
              "enum": ["National", "Regional"]
            }
          },
          {
            "id": "cross_border",
