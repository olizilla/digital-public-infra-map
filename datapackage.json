{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "dpi-map",
  "title": "Digital Public Infrastructure Map",
  "description": "Data on national-scale digital public infrastructure (DPI) around the world, collected by researchers at UCL IIPP and shown at https://dpimap.org: digital identity, payment and data exchange systems, by country or region.",
  "resources": [
    {
      "name": "identity",
      "path": "public/data/latest/identity.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "missingValues": ["NA"],
        "fields": [
          {
            "id": "country",
            "name": "Country / Region",
            "title": "Country / Region",
            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "id": "last_updated",
            "name": "Last updated",
            "title": "Last updated",
            "type": "date",
            "format": "%d/%m/%y",
            "constraints": {
              "required": true
            }
          },
          {
            "id": "dpi_count",
            "name": "Count for DPI",
            "title": "DPI based digital ID count for visualisation",
            "type": "integer",
            "constraints": {
              "required": true,
              "enum": [0, 1]
            }
          },
          {
            "id": "claim",
            "name": "Claim of digital ID",
            "title": "Claim of digital ID",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "name",
            "name": "Digital ID name",
            "title": "Digital ID Name",
            "type": "string"
          },
          {
            "id": "url",
            "name": "URL",
            "title": "URL",
            "type": "string",
            "constraints": {
              "pattern": "https?://\\S+"
            }
          },
          {
            "id": "biometrics",
            "name": "Collects or uses biometric data",
            "title": "Collects or uses biometric data",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "status",
            "name": "Status of Implementation",
            "title": "Status of Implementation",
            "type": "string",
            "constraints": {
              "enum": ["Planned/Piloted", "Implemented"]
            }
          },
          {
            "id": "id_act",
            "name": "ID or Civil Registry Act",
            "title": "ID or Civil Registry Act",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "regulation",
            "name": "Regulation for digital ID",
            "title": "Regulation for digital ID",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "digital_auth",
            "name": "Digital authentication function",
            "title": "Digital authentication function",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "kyc",
            "name": "Enables KYC packet collection",
            "title": "Enables KYC packet collection",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "gov_portal_auth",
            "name": "Authentication through government portal",
            "title": "Authentication through government portal",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "legal_status",
            "name": "Codified digital ID legal status",
            "title": "Codified digital ID legal status",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "governing_entity",
            "name": "Governing entity",
            "title": "Governing entity",
            "type": "string"
          },
          {
            "id": "legal_redress",
            "name": "Legally binding redress mechanism ",
            "title": "Legally binding redress mechanism",
            "type": "string",
            "constraints": {
              "enum": ["Customer service mechanism", "Legally binding mechanism", "Both"]
            }
          },
          {
            "id": "storage_sharing_terms",
            "name": "Terms of data storage and sharing available",
            "title": "Terms of data storage and sharing available",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "data_protection_act",
            "name": "National Data Protection Act",
            "title": "National Data Protection Act",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "enrolment_rules",
            "name": "Procedural rules for digital ID enrolment ",
            "title": "Procedural rules for digital ID enrolment",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "data_leak_disclosure",
            "name": "Data leak disclosure process",
            "title": "Data leak disclosure process",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "data_handling_terms",
            "name": "ID data handling terms",
            "title": "ID data handling terms",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "feeder_documents",
            "name": "Relationship with feeder documents",
            "title": "Relationship with feeder documents",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "sectoral_use_cases",
            "name": "Two or more sectoral use cases enabled",
            "title": "Two or more sectoral use cases enabled",
            "type": "string",
            "constraints": {
              "enum": ["Yes", "No"]
            }
          },
          {
            "id": "funders",
            "name": "Funding organizations identified",
            "title": "Funding organizations identified",
            "type": "string"
          },
          {
            "id": "technical_support",
            "name": "Technical support organizations identified",
            "title": "Technical Support organizations identified",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "payment",
      "path": "public/data/latest/payment.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "missingValues": ["NA"],
        "fields": [
          {
            "id": "country",
            "name": "Country / Region",
            "title": "Country / Region",
            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "id": "last_updated",
            "name": "Last updated",
            "title": "Last updated",
            "type": "date",
            "format": "%d/%m/%y",
            "constraints": {
              "required": true
            }
          },
          {
            "id": "dpi_count",
            "name": "Count for DPI",
