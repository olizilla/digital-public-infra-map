---
import '/src/styles/global.css'
import Header from '../components/Header.astro';
import { dataset } from '../Citation'
import type { MetaTag } from '../CitationMeta'

// `fullTitle` replaces the whole title, for pages that name the site their own way.
// `description` is the page's own, where it has one. `citation` is the page's citation meta tags,
// for Zotero and other reference managers (src/CitationMeta.ts). `noindex` keeps the page out of
// search engines, as for the pending changes (D81). `shareTitle` and `shareDescription` replace the
// title and description in the link preview only (Open Graph and Twitter), as the homepage does: its
// page is the digital ID map, but a shared link to it stands for the whole site.
const {title} = Astro.props
const fullTitle = Astro.props.fullTitle ?? (title ? `${title} - DPI Map` : 'Digital Public Infrastructure Map - UCL IIPP')
const desc: string = Astro.props.description || 'The first global investigation of digital public infrastructure.'
const citation: MetaTag[] = Astro.props.citation ?? []
const pageUrl = Astro.url
const rootUrl = Astro.site
const imgUrl = new URL('/map/preview.png', rootUrl)
// the preview image's size, as src/pages/map/preview.png.ts renders it, and what it shows
const img = { width: 1200, height: 630, alt: 'A world map from the DPI Map, with countries shaded by the status of their digital public infrastructure' }
const shareTitle: string = Astro.props.shareTitle ?? fullTitle
const shareDescription: string = Astro.props.shareDescription ?? desc
---

<!doctype html>
<html lang="en" class="bg-white">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" sizes="48x48">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🗺️</text></svg>">
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="alternate" type="application/rss+xml" title="DPI Map Insights" href="/rss.xml" />
		<title>{fullTitle}</title>
		<meta name="title" content={fullTitle} />
		<meta name="description" content={desc} />
		<link rel="canonical" href={pageUrl} />
		{ Astro.props.noindex && <meta name="robots" content="noindex" /> }
		<meta property="og:site_name" content={dataset.title} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:title" content={shareTitle} />
		<meta property="og:description" content={shareDescription} />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:image" content={imgUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={String(img.width)} />
		<meta property="og:image:height" content={String(img.height)} />
		<meta property="og:image:alt" content={img.alt} />
		<!-- Twitter/X reads name=, not property= -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={shareTitle} />
		<meta name="twitter:description" content={shareDescription} />
		<meta name="twitter:image" content={imgUrl} />
		<meta name="twitter:image:alt" content={img.alt} />
		{ citation.some(meta => meta.name.startsWith('DC.')) && <link rel="schema.DC" href="http://purl.org/dc/elements/1.1/" /> }
		{ citation.map(meta => <meta name={meta.name} content={meta.content} />) }
	</head>
	<body class={Astro.props.bodyClass ?? ''}>
		<Header />
		<slot />
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-S6Q8LFD9PE"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-S6Q8LFD9PE');
		</script>
	</body>
</html>
