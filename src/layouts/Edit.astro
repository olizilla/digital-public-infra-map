---
// The layout for the edit pages, /<id>/edit/ (D87). Editing code lives in the edit pages
// (src/pages/[system]/edit.astro), in src/components/edit and in this layout, never in public pages,
// and nothing links to them yet (D59). Edit pages are not for search engines: robots.txt disallows
// /*/edit/, each page says noindex, and the sitemap leaves them out. The page is the <main>.
import '/src/styles/global.css'
import Header from '../components/Header.astro'

const { title } = Astro.props
const fullTitle = title ? `${title} - Edit - DPI Map` : 'Edit - DPI Map'
---

<!doctype html>
<html lang="en" class="bg-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🗺️</text></svg>">
    <title>{fullTitle}</title>
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>
