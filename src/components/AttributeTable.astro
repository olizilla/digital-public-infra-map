---
// The framework's attributes, each row with an id from its name (src/Methodology.ts), like
// #privacy-safety-and-security, so the codebook can link a variable to the attribute it measures.
import { getCollection } from 'astro:content'
import { attributeAnchor } from '../Methodology'
const attrs = await getCollection('dpiAttributes')
---
<div class="lg:-mx-20">
  <table class="attribute-table">
    <thead>
      <tr><th>#</th><th>Attribute</th><th>Description</th></tr>
    </thead>
    <tbody>
      { attrs.map(({data}) => (
        <tr id={attributeAnchor(data.attribute)}><td>{data.id}</td><td class="font-bold">{data.attribute}</td><td set:html={data.description.replaceAll('\\n', '<br/>')}></td></tr>
      ))}
    </tbody>
  </table>
</div>
