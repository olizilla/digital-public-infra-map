---
// A person on the About page: their photo, name and role, linking to their profile. A card, as the site's cards are.
const { name, link, imgSrc, imgAlt = `Photo of ${name}` } = Astro.props
---

<figure class="team-card">
  <a href={link}><img src={imgSrc} alt={imgAlt} /></a>
  <figcaption>
    <h3><a href={link}>{name}</a></h3>
    <div class="team-card-role"><slot/></div>
  </figcaption>
</figure>
