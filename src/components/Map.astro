---
import MapSvg from './MapSvg.astro'
const { grid = false, nocrop = false, dpiType = 'id', legend = false } = Astro.props
---
<figure class="map mx-auto block lg:py-4">
  <MapSvg grid={grid} nocrop={nocrop} dpiType={dpiType} />
  <figcaption>
    <p class="text-center font-sans tracking-wide text-zinc-500 text-xs">
      { dpiType === 'id' && 'Digital ID System' }
      { dpiType === 'pay' && 'Payment System' }
      { dpiType === 'data' && 'Data Exchange System' }
      implementation status by country
    </p>
    { legend &&
      <div class="flex flex-wrap justify-center gap-x-3.5 gap-y-1 pt-1.5 font-sans text-xs text-zinc-600">
        <span class="inline-flex items-center gap-1.5"><i class="size-3 rounded-[3px] bg-dpi"></i>DPI-like</span>
        <span class="inline-flex items-center gap-1.5"><i class="size-3 rounded-[3px] bg-wip"></i>WIP</span>
        <span class="inline-flex items-center gap-1.5"><i class="size-3 rounded-[3px] bg-na"></i>NA</span>
        <a href="/methodology/" class="ul">How we count DPI-like systems</a>
      </div>
    }
  </figcaption>
</figure>
