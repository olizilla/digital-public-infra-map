---
import { getCollection } from 'astro:content'
import { formatDate } from '../Insights'
const posts = await getCollection('blog', ({data}) => data.published)
posts.sort(
  (a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''),
)

---

<ul>
  { posts.map(p => (
    <li>
      <span class="font-bold">{formatDate(p.data.date)}</span> - 
      <a href={`/blog/${p.id}`}>
        {p.data.title}
      </a>
    </li>
  ))}
</ul>