---
// A country page's header, shared by the country page and its systems' pages so that clicking
// from one to the other moves nothing: the country's name, its summary sentence, the links, and the
// locator map. A system's page has a breadcrumb, its DPI type with its icon, linking to the country page's
// lane for that type; the country's name is right under it, and looks the same but isn't the page's h1:
// the system's name is. A place page has no breadcrumb.
// The text is a PageHeader; the grid and the map are styled by .page-head in src/styles/global.css.
import LocatorMap from './LocatorMap.astro'
import PageHeader from './PageHeader.astro'
import { lanesOf, summaryOf } from '../CountryPage'
import type { DPIType } from '../Schema'

interface Props {
	country: string
	/** the country page's path, to link a system page's breadcrumb and title */
	countryHref?: string
	/** on a system's page, its DPI type (the title then links to the place page). No breadcrumb on either */
	dpiType?: DPIType
}
const { country, countryHref, dpiType } = Astro.props
const summary = summaryOf(country, lanesOf(country))
const Name = dpiType === undefined ? 'h1' : 'p'
---
<!-- on desktop, the same three columns as the lanes below, so the map lines up with the third column -->
<section class="page-head">
	<PageHeader as="div" class="page-head-text" titleAs={Name}>
		<Fragment slot="title">{ dpiType !== undefined && countryHref ? <a href={countryHref}>{country}</a> : country }</Fragment>
		<Fragment slot="lede" set:html={summary} />
		<Fragment slot="links"><a href="/methodology/">How we count DPI-like systems</a> · <a href="#cite">Cite this page</a></Fragment>
	</PageHeader>
	<!-- on mobile the map comes first, where the homepage map is, so scrolling past it doesn't tap its links.
	     It stays after the text in the source, so keyboard and screen reader users reach the heading before the map's links -->
	<LocatorMap country={country} class="page-map" />
</section>
