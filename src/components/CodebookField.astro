---
// A field's name in the changelog's codebook changes (CodebookChanges.astro): its codebook title, and a
// link to its codebook page if the release has the field.
import type { FieldRef } from '../CodebookChanges'

interface Props {
  field: FieldRef
  href?: string
}
const { field, href } = Astro.props
---
{ href ? <a class="chg-cb-name" href={href}>{field.title}</a> : <span class="chg-cb-name">{field.title}</span> }
