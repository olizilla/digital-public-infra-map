---
// A system's implementation status on its own line, then the DPI test criteria, each with a YES/NO/NF/NA pill.
// The status is also the first criterion ('Active'), but "NO Active (pilot)" confused readers, so it's shown apart.
// The status line and its pill come from statusOf (src/DpiTest.ts), which keeps Not Found apart from NA (D61).
// Each line's label links to its field's codebook page, as the cards' other labels do (SystemFields).
// Styled by .dpi-test in src/styles/global.css, smaller in a listing card (.card-id, .card-pay, .card-data).
import YesNo from './YesNo.astro'
import { dpiTest, statusOf } from '../DpiTest'
import { codebookPathFor } from '../Codebook'
import type { DPIType } from '../Schema'

interface Props {
  dpiType: DPIType
  record: Record<string, any>
}
const { dpiType, record } = Astro.props
/** the status's pill: YES for active, WIP for a pilot or plan, NO for suspended, NF for Not Found, NA for no answer */
const { card, pill } = statusOf(dpiType, record)
const criteria = dpiTest(dpiType, record).filter(c => c.label !== 'Active')
const href = (field: string) => codebookPathFor(dpiType, field)
---
<ul class="dpi-test">
	<li>{ pill === 'nf' ? <YesNo status="Not Found" /> : <span class={`pill ${pill}`}>{pill.toUpperCase()}</span> }<a href={href('status')}>Status: {card}</a></li>
  { criteria.map(c => (
	  <li>
	    <YesNo status={c.value} /> <a href={href(c.field)} title={c.label}>{c.label}</a>
	  </li>
  ))}
</ul>
