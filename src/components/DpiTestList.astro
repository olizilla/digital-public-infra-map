---
// The DPI test criteria for a system, each with a YES/NO/NA pill.
// Styled by .dpi-test in src/styles/global.css, smaller in a listing card (.card-id, .card-pay, .card-data).
import YesNo from './YesNo.astro'
import { dpiTest } from '../DpiTest'
import type { DPIType } from '../Schema'

interface Props {
  dpiType: DPIType
  record: Record<string, any>
}
const { dpiType, record } = Astro.props
---
<ul class="dpi-test">
  { dpiTest(dpiType, record).map(c => (
    <li>
      <YesNo status={c.value} />
      { c.note ? <span>{c.label}<span class="note"> ({c.note})</span></span> : c.label }
    </li>
  ))}
</ul>
