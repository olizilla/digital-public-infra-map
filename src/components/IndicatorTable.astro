---
import { getCollection } from 'astro:content'
const {dpi} = Astro.props
const collName = `${dpi}Indicators`
const indicators = await getCollection(collName)
const attrs = await getCollection('dpiAttributes')

/*
Indicator numbers are numbered per DPI type, so they don't always match the attribute ids.
Data exchange has no "Non-discrimination and inclusion" indicators, so its 4.x indicators
are "Capacity and coordination" (attribute 5) and its 5.x are "Scale of adoption" (attribute 6).
*/
const attributeForIndicator: Record<string, Record<string, string>> = {
  data: { '4': '5', '5': '6' }
}

let lastAttributeID = null
---
<div class="lg:-mx-12">
  <table class="indicator-table">
    <thead>
      <tr><th>#</th><th>Indicator</th></tr>
    </thead>
    <tbody>
      { indicators.map(({data}) => {
        const indicatorGroup = data.id.split('.')[0]
        const attributeId = attributeForIndicator[dpi]?.[indicatorGroup] ?? indicatorGroup
        if (lastAttributeID === attributeId) {
          return <tr><td>{data.id}</td><td>{data.indicator}</td></tr>
        }
        const attr = attrs.find(a => a.id === attributeId)
        lastAttributeID = attr?.id
        return (
          <tr><td class="label bg-zinc-50" colspan="2">{attr?.data.attribute}</td></tr>
          <tr><td>{data.id}</td><td>{data.indicator}</td></tr>
        )
      })}
    </tbody>
  </table>
</div>
