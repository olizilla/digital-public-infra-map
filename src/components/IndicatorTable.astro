---
// A DPI type's indicators, under the attribute each measures. Each indicator's row has an id, like
// #id-indicator-2-5, so the codebook can link a variable to it (src/Methodology.ts).
import { getCollection } from 'astro:content'
import { attributeOfIndicator, indicatorAnchor } from '../Methodology'
const {dpi} = Astro.props
const collName = `${dpi}Indicators`
const indicators = await getCollection(collName)
const attrs = await getCollection('dpiAttributes')

let lastAttributeID = null
---
<div class="lg:-mx-12">
  <table class="indicator-table">
    <thead>
      <tr><th>#</th><th>Indicator</th></tr>
    </thead>
    <tbody>
      { indicators.map(({data}) => {
        const attributeId = String(attributeOfIndicator(dpi, data.id))
        const row = <tr id={indicatorAnchor(dpi, data.id)}><td>{data.id}</td><td>{data.indicator}</td></tr>
        if (lastAttributeID === attributeId) return row
        const attr = attrs.find(a => a.id === attributeId)
        lastAttributeID = attr?.id
        return <Fragment><tr><td class="eyebrow bg-zinc-50" colspan="2">{attr?.data.attribute}</td></tr>{row}</Fragment>
      })}
    </tbody>
  </table>
</div>
