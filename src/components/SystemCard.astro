---
// A system's card on its country page: name, website and DPI status in a
// header that sticks while the card scrolls, the DPI test, all its fields,
// and when it was last updated. With `collapsed`, the fields sit behind a toggle.
import Status from './Status.astro'
import DpiTestList from './DpiTestList.astro'
import SystemFields from './SystemFields.astro'
import TypeIcon from './TypeIcon.astro'
import { displayValues, nameOf, nouns, presence, valueOf } from '../DpiTest'
import { parseDMY } from '../Util'
import type { DPIType } from '../Schema'

interface Props {
  dpiType: DPIType
  record: Record<string, any>
  collapsed?: boolean
}
const { dpiType, record, collapsed = false } = Astro.props
const named = presence(dpiType, record) === 'named'
const name = named ? nameOf(dpiType, record) : `Unnamed ${nouns[dpiType]} system`
const url = valueOf(dpiType, record, 'url')
const site = url.startsWith('http') ? new URL(url).hostname.replace(/^www\./, '') : undefined
const { count } = displayValues(dpiType, record)

/** "03/09/25" (day/month/year) as "Sep 2025" */
function monthYear (date: string) {
  return parseDMY(date)?.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }) ?? date
}
const updated = valueOf(dpiType, record, 'last_updated')
const systemId = record['System ID']
---
<article class="sys" data-type={dpiType} id={systemId}>
  <header class="sys-head">
    <span class="pin-ico" aria-hidden="true"><TypeIcon dpiType={dpiType} class="size-5!" /></span>
    <div class="flex-1 min-w-0">
      <h3 class:list={['text-lg leading-6 font-semibold', named ? 'text-black' : 'italic font-medium text-zinc-600']}>{name}</h3>
      { site &&
        <a class="inline-block text-[13px] leading-[18px] text-zinc-500 underline decoration-zinc-300 underline-offset-3 hover:text-blue-500" href={url}>{site}<svg class="inline size-3 ml-0.5 align-[-1px]" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4h9v9M16 4 5 15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      }
    </div>
    <Status status={record['DPI Status']} title="DPI status" class="flex-none mt-[3px]" />
  </header>
  <div class="flex flex-col px-4 py-3 bg-white border-b border-zinc-200">
    <span class="block pb-2 text-xs font-semibold text-zinc-600">DPI test</span>
    <DpiTestList dpiType={dpiType} record={record} />
  </div>
  <div class="sys-body px-4 pt-1 pb-2 has-[details:not([open])]:pb-0">
    { collapsed
      ? <details class="more group">
          <summary class="py-3 group-open:pb-0 text-[13px] leading-5 font-medium text-zinc-600">All {count} fields</summary>
          <SystemFields dpiType={dpiType} record={record} />
        </details>
      : <SystemFields dpiType={dpiType} record={record} />
    }
  </div>
  <footer class="sys-foot flex items-center gap-2.5 mt-2 px-4 py-2.5 bg-white border-t border-zinc-200 rounded-b-lg text-xs leading-5 text-zinc-500">
    <span>Updated {monthYear(updated)}</span>
    <a class="ml-auto font-semibold text-zinc-700 hover:text-blue-500" href="/contribute/">Propose an update</a>
  </footer>
</article>
