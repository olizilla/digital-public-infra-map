---
// The icon for a DPI type, in the type's colour.
import IdentityIcon from './icons/IdentityIcon.astro'
import PaymentIcon from './icons/PaymentIcon.astro'
import DataIcon from './icons/DataIcon.astro'
import type { DPIType } from '../Schema'

interface Props {
  dpiType: DPIType
  class?: string
}
const { dpiType, class: className } = Astro.props
---
{ dpiType === 'id' && <IdentityIcon class:list={['flex-none text-zinc-600', className]} /> }
{ dpiType === 'pay' && <PaymentIcon class:list={['flex-none text-emerald-700', className]} /> }
{ dpiType === 'data' && <DataIcon class:list={['flex-none text-blue-600', className]} /> }
