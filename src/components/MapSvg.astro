---
import features from '../../public/features.json'
import topojson from 'topojson-client'
import * as d3 from 'd3-geo'
import * as d3p from 'd3-geo-projection'
import { dpiStatusToClass } from '../Status'
import { pages, records } from '../Records'
import { placeNamed } from '../Places'

const { grid = false, nocrop = false, dpiType = 'id' } = Astro.props
// shapes only: the map's points, for places too small to have a shape, are for the locator maps
const regions = topojson.feature(features, "world").features.filter(region => region.geometry.type !== 'Point')
const graticule = d3.geoGraticule10()
const projection = d3p.geoNaturalEarth2()
// to 0.1 map units (the map is 800 wide): about a third smaller, and no visible change
const path = d3.geoPath(projection).digits(1)
const outline = { type: "Sphere" }
const width = 800

// from Bostock: https://observablehq.com/@d3/world-map-svg
function height () {
  const [[x0, y0], [x1, y1]] = d3.geoPath(projection.fitWidth(width, outline)).bounds(outline);
  const dy = Math.ceil(y1 - y0), l = Math.min(Math.ceil(x1 - x0), dy);
  projection.scale(projection.scale() * (l - 1) / l).precision(0.2);
  return dy;
}

const codeOf = (row: Record<string, any>) => placeNamed(row.country)?.code
// each place's system of this DPI type: the first, as the data is sorted most DPI-like first
const systems = new Map<string, Record<string, any>>()
for (const row of records[dpiType as keyof typeof records]) {
  const code = codeOf(row)
  if (code && !systems.has(code)) systems.set(code, row)
}

// On the site the fill comes from the .status-* classes, which use the
// --color-dpi/wip/na theme colours in src/styles/global.css. These hex values
// are only the fallback for the standalone /map/preview.svg and .png, which
// have no stylesheet. They are the same Tailwind colours, as sRGB hex (v3 values, near enough).
function statusToColor (s: string) {
  if (s === 'DPI') return '#bbf7d0'  // --color-dpi: green-200
  if (s === 'WIP') return '#fde68a'  // --color-wip: amber-200
  return '#e4e4e7'                   // --color-na: zinc-200
}

const cropLeft = nocrop ? 0 : 90 // trim hard-to-see islands. data still available in card list view.
const cropRight = nocrop ? -20 : 90
const cropBottom = 60
---
<svg viewBox={`${cropLeft} 0 ${width - cropRight} ${height() - cropBottom}`} version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
  <defs>
    <path id="outline" d={path(outline)} />
    <clipPath id="clip"><use href="#outline" /></clipPath>
  </defs>
  <g clip-path="url(#clip)">
    <use href="#outline" fill="none"/>
    {grid && <path d={path(graticule)} fill="none" class="stroke-blue-100"></path>}
    <g class="regions">
    { regions.map(region => {
      const code = region.id
      const page = code ? pages.get(code) : undefined
      const dpi = code ? systems.get(code) : undefined
      const status = dpi?.['DPI Status']
      const shape = <path d={path(region)} class={dpiStatusToClass(status)} fill={statusToColor(status)} stroke="#acc" style="stroke-width: 0.5px;"></path>
      // a place without a page gets no link
      return page
        ? <a href={page.href}><title>{page.name}
{dpi?.name}</title>{shape}</a>
        : <g><title>{region.properties.name}</title>{shape}</g>
    })}
    </g>
  </g>
  <use href="#outline" fill="none" class="stroke-1" />
</svg>
