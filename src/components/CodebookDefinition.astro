---
import KeyLabel from '../components/KeyLabel.astro'
import type { CodebookVariable } from '../Codebook'

const variable: CodebookVariable = Astro.props.variable
// the variable's own page, if a field in the data has it
const href: string | undefined = Astro.props.href
const { anchor, codes, indicator } = variable
---
{ variable.name !== 'DPI based digital ID count for visualisation' && (
<div class="pt-15" id={anchor}>
  <header>
    <a class="font-bold text-lg m-0" href={href ?? `#${anchor}`}>
      {variable.name}
    </a>
  </header>
  <div class="lg:flex mt-2">
    <div class="flex-3/4">
      <p class="mt-0">{variable.description}</p>
      { codes.length > 0 && (
        <KeyLabel>Values</KeyLabel>
      )}
      { codes.map(({key, value}) => (<p><span class="font-bold">{key}</span> &ndash; {value}</p>))}
      {indicator && (
      <div class="my-5">
        <KeyLabel>Related Indicator in Measuring DPI Framework</KeyLabel>
        <span class="text-sm italic text-zinc-600 whitespace-pre-wrap">{indicator}</span>
      </div>
      ) }
    </div>
    <div class="flex-1/4 flex lg:flex-col lg:border-l-2 border-zinc-100 lg:pl-4 lg:ml-4">
      <div class="mr-4">
        <KeyLabel class="inline">Scope</KeyLabel>
        <span class="text-sm">{variable.scope}</span>
      </div>
      <div class="mr-4">
        <KeyLabel class="inline">Type</KeyLabel>
        <span class="text-sm">{variable.type}</span>
      </div>
    </div>
  </div>
</div>
)}