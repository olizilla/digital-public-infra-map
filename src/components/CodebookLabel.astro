---
import { codebookAnchorForLabel } from '../Codebook'
const key = Astro.props.key
const dpi = Astro.props.dpiType
// throws (failing the build) if the codebook has no matching variable
const url = `/codebook/#${codebookAnchorForLabel(dpi, key)}`
const cls = ["block text-xs uppercase font-mono tracking-wide text-zinc-500 pt-2 hover:text-blue-500 align-bottom", Astro.props.class]
---
<a href={url} class:list={cls} class="ali">
  {key}
</a>
