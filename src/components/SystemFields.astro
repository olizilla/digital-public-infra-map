---
// All the fields of a system that the DPI test doesn't already show:
// yes/no flags as a pill column, then text fields with the label above the value.
// Labels link to their variable's page in the codebook.
// Styled by .field-flags and .field-texts in src/styles/global.css, smaller in a listing card (.card-id, .card-pay, .card-data).
import YesNo from './YesNo.astro'
import { displayValues } from '../DpiTest'
import { codebookPathFor } from '../Codebook'
import type { DPIType } from '../Schema'

interface Props {
  dpiType: DPIType
  record: Record<string, any>
}
const { dpiType, record } = Astro.props
const { flags, texts } = displayValues(dpiType, record)
const href = (id: string) => codebookPathFor(dpiType, id)
---
{ flags.length > 0 &&
  <ul class="field-flags">
    { flags.map(f => (
      <li class:list={{ na: f.flag === 'NA' }}>
        <YesNo status={f.flag} />
        <a href={href(f.id)}>{f.label}</a>
      </li>
    ))}
  </ul>
}
{ texts.length > 0 &&
  <dl class="field-texts">
    { texts.map(f => (
      <div class:list={{ na: f.value === 'NA' }}>
        <dt><a href={href(f.id)}>{f.label}</a></dt>
        { f.value === 'NA' ? <dd title="No data">NA</dd> : <dd>{f.value}</dd> }
      </div>
    ))}
  </dl>
}
