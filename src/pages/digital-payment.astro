---
import Layout from '../layouts/Layout.astro'
import MapAndTabs from '../components/MapAndTabs.astro'
import TypeIcon from '../components/TypeIcon.astro'
import { Payments } from '../Payment.js'
import Footer from '../components/Footer.astro'
import CardSection from '../components/CardSection.astro'
import ListingCard from '../components/ListingCard.astro'
import StatusBar from '../components/StatusBar.astro'

const items = Payments
const dpiType = 'pay'
---
<Layout>
	<MapAndTabs countryCount={items.length} dpiType={dpiType} />
	<StatusBar items={items} />
	<CardSection title="Digital Payment Systems" items={items}>
		<TypeIcon dpiType="pay" class="inline" slot="icon" />
		{ items.map(record => <ListingCard dpiType={dpiType} record={record} />) }
	</CardSection>
	<Footer />
</Layout>
