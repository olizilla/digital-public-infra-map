---
import slug from 'slug'
import Layout from '../layouts/Layout.astro'
import Footer from '../components/Footer.astro'
import CountryHeader from '../components/CountryHeader.astro'
import SystemCard from '../components/SystemCard.astro'
import TypeIcon from '../components/TypeIcon.astro'
import { citedDateOf, lanesOf, laneAnchors } from '../CountryPage'
import { placesWithPages, records } from '../Records'
import { systemHref } from '../Systems'

export async function getStaticPaths () {
	const countries = [...new Set(Object.values(records).flat().map(({ country }) => country as string))]
		.filter(country => placesWithPages.has(country))
		.sort((a, b) => a.localeCompare(b, 'en'))
	return countries.map((country, i) => ({
		params: { country: slug(country) },
		props: {
			country,
			prev: countries[(i - 1 + countries.length) % countries.length],
			next: countries[(i + 1) % countries.length],
		}
	}))
}

const { country, prev, next } = Astro.props

const lanes = lanesOf(country)
const multi = lanes.some(lane => lane.systems.length > 1)
// cite the page by the date of its newest data
const citedDate = citedDateOf(lanes)
---

<Layout title={country}>
	<main class="page">
		<CountryHeader country={country} />

		<section class:list={['lanes', { multi }]}>
			{ lanes.map(lane => (
				<div class="lane" data-type={lane.dpiType} id={laneAnchors[lane.dpiType]}>
					<h2 class="lane-head">
						{ lane.systems[0]?.system_id
							? <a href={systemHref(lane.systems[0].system_id)}><TypeIcon dpiType={lane.dpiType} /><span>{lane.title}</span></a>
							: <Fragment><TypeIcon dpiType={lane.dpiType} /><span>{lane.title}</span></Fragment> }
						{ lane.systems.length > 1 && <span class="lane-count">{lane.systems.length} systems</span> }
					</h2>
					{ lane.systems.map(record => <SystemCard dpiType={lane.dpiType} record={record} collapsed={lane.systems.length > 1} />) }
					{ lane.systems.length === 0 &&
						<div class="sys-empty px-4 py-5 bg-white border border-dashed border-zinc-300 rounded-lg text-sm text-zinc-600">
							{ lane.researched
								? <Fragment><p>No {lane.noun} system found in public sources.</p><a class="inline-block mt-1.5 font-semibold text-zinc-700 hover:text-blue-500" href="/contribute/">Know of one? Propose it</a></Fragment>
								: <Fragment><p>No {lane.noun} system recorded yet.</p><a class="inline-block mt-1.5 font-semibold text-zinc-700 hover:text-blue-500" href="/contribute/">Propose one</a></Fragment>
							}
						</div>
					}
				</div>
			))}
		</section>

		<nav class="country-nav" aria-label="Countries">
			<a class="prev" href={`/${slug(prev)}/`} title={prev}><span aria-hidden="true">←</span><span class="name">{prev}</span></a>
			<a class="all" href="/">All countries</a>
			<a class="next" href={`/${slug(next)}/`} title={next}><span class="name">{next}</span><span aria-hidden="true">→</span></a>
		</nav>

		<section class="grid min-[901px]:grid-cols-2 gap-6 mt-6 pt-5 border-t border-zinc-200 text-sm leading-[22px] text-zinc-600">
			<div>
				<h2 class="mb-1 font-semibold leading-5 text-zinc-700">Where this data comes from</h2>
				<p>Desk research of public sources: government websites, laws, press releases, and reports from bodies like the World Bank and UN, plus validated submissions from country implementers.</p>
			</div>
			<div id="cite">
				<h2 class="mb-1 font-semibold leading-5 text-zinc-700">Cite this page</h2>
				<p class="font-mono text-xs leading-[18px]">DPI Map ({citedDate}). {country}. Institute for Innovation and Public Purpose, UCL. https://dpimap.org/{slug(country)}/</p>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
