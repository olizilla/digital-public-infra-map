---
import Layout from '../layouts/Layout.astro'
import MapAndTabs from '../components/MapAndTabs.astro'
import TypeIcon from '../components/TypeIcon.astro'
import { IDs } from '../Identity.js'
import { Payments } from '../Payment.js'
import { DataExchanges } from '../DataExchange.js'
import Footer from '../components/Footer.astro'
import CardSection from '../components/CardSection.astro'
import ListingCard from '../components/ListingCard.astro'
import { presence } from '../DpiTest'
import StatusBar from '../components/StatusBar.astro'
import SourceAndCite from '../components/SourceAndCite.astro'
import { mapDescription, recordCitation, siteShareDescription } from '../CitationMeta'
import { oneSystemPerCountry } from '../Util'

const items = IDs
const dpiType = 'id'
// the cards are for systems: places where research found none are on the map, not here
const systems = items.filter(record => presence(dpiType, record) !== 'not-found')
// the page as a view of the data, a Dataset in Zotero, cited like a record by the release (src/CitationMeta.ts),
// and described by its status bar's counts: the countries researched, one system each, and how many are DPI-like
const title = 'Digital ID systems'
const countries = oneSystemPerCountry(items)
const description = mapDescription({ title, countries: countries.length, dpiLike: countries.filter(row => row['DPI Status'] === 'DPI').length })
const citation = recordCitation({ title, path: '' })
// a shared link to the homepage stands for the whole site, so its preview names all three types
const dpiLikeIn = (rows: Record<string, any>[]) => oneSystemPerCountry(rows).filter(row => row['DPI Status'] === 'DPI').length
const shareDescription = siteShareDescription({ id: dpiLikeIn(IDs), pay: dpiLikeIn(Payments), data: dpiLikeIn(DataExchanges) })
---
<Layout title={title} description={description} citation={citation.meta(description)} shareTitle="The Digital Public Infrastructure Map" shareDescription={shareDescription}>
	<MapAndTabs countryCount={items.length} dpiType={dpiType} />
	<StatusBar items={items} />
	<CardSection title="Digital ID Systems" items={systems}>
		<TypeIcon dpiType="id" class="inline" slot="icon" />
		{ systems.map(record => <ListingCard dpiType={dpiType} record={record} />) }
	</CardSection>
	<div class="page pt-0">
		<SourceAndCite citation={citation.text} />
	</div>
	<Footer />
</Layout>
