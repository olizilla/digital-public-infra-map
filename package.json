{
  "name": "digital-public-infra-map",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "start": "astro dev",
    "test": "npm run data:check && astro build && npm run links",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "links": "npx linkinator ./dist --recurse --timeout 5000 --skip '^https?://(?!localhost[:/])' --verbosity error",
    "data": "DATE=${DATE:=$(date +'%Y-%m-%d')} && mkdir \"./public/data/$DATE\" && run-p data:identity data:payment data:exchange",
    "data:identity": "DATE=${DATE:=$(date +'%Y-%m-%d')} && curl -Ss --output ./public/data/$DATE/$DATE-identity.json http://localhost:4321/api/identity.json",
    "data:payment": "DATE=${DATE:=$(date +'%Y-%m-%d')} && curl -Ss --output ./public/data/$DATE/$DATE-payment.json http://localhost:4321/api/payment.json",
    "data:exchange": "DATE=${DATE:=$(date +'%Y-%m-%d')} && curl -Ss --output ./public/data/$DATE/$DATE-exchange.json http://localhost:4321/api/exchange.json",
    "data:build": "node scripts/data-build.ts",
    "data:check": "node scripts/data-build.ts --check",
    "validate": "node scripts/validate.mjs",
    "codebook:check": "node scripts/codebook-check.mjs",
    "test:changesets": "node --test 'lib/changesets/test/*.test.ts'"
  },
  "dependencies": {
    "@ascorbic/csv-loader": "^2.0.3",
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.11",
    "ajv": "^8.20.0",
    "astro": "^5.9.1",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "sharp": "^0.34.2",
    "slug": "^10.0.0",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.1.11",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/slug": "^5.0.9",
    "@types/topojson-client": "^3.1.5",
    "exceljs": "^4.4.0",
    "linkinator": "^6.1.2",
    "npm-run-all2": "^8.0.4",
    "papaparse": "^5.7.0"
  }
}
